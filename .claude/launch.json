{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-demo",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-X", "utf8", "web/app.py", "--port", "8770"],
      "port": 8770
    },
    {
      "name": "medkg-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
