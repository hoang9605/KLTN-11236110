{"id": "RV2T-001", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 62, "selection": "targeted", "text": "cũng như là các cái thảo dược hoặc là các cái bài thuốc độc hoạt tang ký sinh như thế này cũng là những cái giải pháp", "entities": [{"id": "E1", "text": "thảo dược", "label": "DRUG", "start": 20, "end": 29, "token_start": 5, "token_end": 7}, {"id": "E2", "text": "thuốc độc hoạt tang", "label": "DRUG", "start": 50, "end": 69, "token_start": 12, "token_end": 16}, {"id": "E3", "text": "ký sinh", "label": "CONDITION", "start": 70, "end": 77, "token_start": 16, "token_end": 18}], "pairs": [{"head": "E3", "tail": "E1", "allowed_relation": "treated_by", "id": "R1"}, {"head": "E3", "tail": "E2", "allowed_relation": "treated_by", "id": "R2"}]}
{"id": "RV2T-002", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 1052, "selection": "targeted", "text": "nhức mỏi chân tay khi mà sử dụng các loại thuốc giảm đau tuần hoàn não hoạt huyết vẫn chưa có cảm nhận hiệu quả và", "entities": [{"id": "E1", "text": "nhức mỏi", "label": "CONDITION", "start": 0, "end": 8, "token_start": 0, "token_end": 2}, {"id": "E2", "text": "chân tay", "label": "BODY_PART", "start": 9, "end": 17, "token_start": 2, "token_end": 4}, {"id": "E3", "text": "thuốc giảm đau", "label": "DRUG", "start": 42, "end": 56, "token_start": 10, "token_end": 13}, {"id": "E4", "text": "tuần hoàn não", "label": "TEST", "start": 57, "end": 70, "token_start": 13, "token_end": 16}], "pairs": [{"head": "E1", "tail": "E2", "allowed_relation": "located_at", "id": "R1"}, {"head": "E1", "tail": "E3", "allowed_relation": "treated_by", "id": "R2"}, {"head": "E1", "tail": "E4", "allowed_relation": "diagnosed_by", "id": "R3"}]}
{"id": "RV2T-003", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 1057, "selection": "targeted", "text": "cái người trầm cảm mà đang dùng thuốc này thì nó sẽ phải được điều chỉnh tốt hơn và khi mà qua cái giai đoạn mà mổ", "entities": [{"id": "E1", "text": "trầm cảm", "label": "CONDITION", "start": 10, "end": 18, "token_start": 2, "token_end": 4}, {"id": "E2", "text": "điều chỉnh", "label": "DRUG", "start": 62, "end": 72, "token_start": 14, "token_end": 16}, {"id": "E3", "text": "mổ", "label": "PROCEDURE", "start": 112, "end": 114, "token_start": 26, "token_end": 27}], "pairs": [{"head": "E1", "tail": "E2", "allowed_relation": "treated_by", "id": "R1"}, {"head": "E1", "tail": "E3", "allowed_relation": "treated_by_procedure", "id": "R2"}]}
{"id": "RV2T-004", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 1168, "selection": "targeted", "text": "đi nếu mà người bệnh đi lại chậm chạp mà cải thiện với thuốc levodopa nhưng do", "entities": [{"id": "E1", "text": "chậm", "label": "CONDITION", "start": 28, "end": 32, "token_start": 7, "token_end": 8}, {"id": "E2", "text": "cải thiện", "label": "PROCEDURE", "start": 41, "end": 50, "token_start": 10, "token_end": 12}, {"id": "E3", "text": "levodopa", "label": "DRUG", "start": 61, "end": 69, "token_start": 14, "token_end": 15}], "pairs": [{"head": "E1", "tail": "E2", "allowed_relation": "treated_by_procedure", "id": "R1"}, {"head": "E1", "tail": "E3", "allowed_relation": "treated_by", "id": "R2"}]}
{"id": "RV2T-005", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 1294, "selection": "targeted", "text": "sẽ bớt sinh ra các tế bào ung thư cho nên là việc mà sử dụng kẽm với lại", "entities": [{"id": "E1", "text": "tế bào ung thư", "label": "CONDITION", "start": 19, "end": 33, "token_start": 5, "token_end": 9}, {"id": "E2", "text": "kẽm", "label": "DRUG", "start": 61, "end": 64, "token_start": 16, "token_end": 17}], "pairs": [{"head": "E1", "tail": "E2", "allowed_relation": "treated_by", "id": "R1"}]}
{"id": "RV2T-006", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 1412, "selection": "targeted", "text": "nguồn gốc từ thảo dược đây là những cái sản phẩm mà cũng đã hoàn toàn một trăm phần trăm từ các cái thảo dược thiên nhiên mà xưa kia", "entities": [{"id": "E1", "text": "thảo dược", "label": "DRUG", "start": 13, "end": 22, "token_start": 3, "token_end": 5}, {"id": "E2", "text": "một trăm phần trăm", "label": "DOSAGE", "start": 70, "end": 88, "token_start": 16, "token_end": 20}, {"id": "E3", "text": "thảo dược", "label": "DRUG", "start": 100, "end": 109, "token_start": 23, "token_end": 25}], "pairs": [{"head": "E1", "tail": "E2", "allowed_relation": "has_dosage", "id": "R1"}, {"head": "E3", "tail": "E2", "allowed_relation": "has_dosage", "id": "R2"}]}
{"id": "RV2T-007", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 1485, "selection": "targeted", "text": "polysaccharide cao gấp bảy lần các cái chế phẩm đông trùng hạ thảo thông thường hiện nay do đó mà các tác dụng tăng", "entities": [{"id": "E1", "text": "polysaccharide", "label": "DRUG", "start": 0, "end": 14, "token_start": 0, "token_end": 1}, {"id": "E2", "text": "cao", "label": "DOSAGE", "start": 15, "end": 18, "token_start": 1, "token_end": 2}, {"id": "E3", "text": "gấp bảy lần", "label": "DOSAGE", "start": 19, "end": 30, "token_start": 2, "token_end": 5}, {"id": "E4", "text": "chế phẩm đông trùng hạ thảo", "label": "DRUG", "start": 39, "end": 66, "token_start": 7, "token_end": 13}], "pairs": [{"head": "E1", "tail": "E2", "allowed_relation": "has_dosage", "id": "R1"}, {"head": "E1", "tail": "E3", "allowed_relation": "has_dosage", "id": "R2"}, {"head": "E4", "tail": "E2", "allowed_relation": "has_dosage", "id": "R3"}, {"head": "E4", "tail": "E3", "allowed_relation": "has_dosage", "id": "R4"}]}
{"id": "RV2T-008", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 1646, "selection": "targeted", "text": "bác sĩ mà chuyên khoa về bệnh xương khớp để theo dõi sát này điều trị sát này điều chỉnh sát và tư vấn sát sao cho bác", "entities": [{"id": "E1", "text": "bệnh xương khớp", "label": "CONDITION", "start": 25, "end": 40, "token_start": 6, "token_end": 9}, {"id": "E2", "text": "điều chỉnh", "label": "DRUG", "start": 78, "end": 88, "token_start": 18, "token_end": 20}], "pairs": [{"head": "E1", "tail": "E2", "allowed_relation": "treated_by", "id": "R1"}]}
{"id": "RV2T-009", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 1672, "selection": "targeted", "text": "bệnh lý nền có thể là tác dụng tốt nhất với thuốc đông trùng hạ thảo ạ có thể nói là câu trả lời luôn là", "entities": [{"id": "E1", "text": "bệnh lý nền", "label": "CONDITION", "start": 0, "end": 11, "token_start": 0, "token_end": 3}, {"id": "E2", "text": "đông trùng hạ thảo", "label": "DRUG", "start": 50, "end": 68, "token_start": 12, "token_end": 16}], "pairs": [{"head": "E1", "tail": "E2", "allowed_relation": "treated_by", "id": "R1"}]}
{"id": "RV2T-010", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 1706, "selection": "targeted", "text": "không thì ở việt nam chúng ta có củ địa liền là một trong những cái thảo dược mà để điều trị cho cái bệnh lý xương khớp", "entities": [{"id": "E1", "text": "thảo dược", "label": "DRUG", "start": 68, "end": 77, "token_start": 16, "token_end": 18}, {"id": "E2", "text": "bệnh lý", "label": "CONDITION", "start": 101, "end": 108, "token_start": 24, "token_end": 26}, {"id": "E3", "text": "xương khớp", "label": "BODY_PART", "start": 109, "end": 119, "token_start": 26, "token_end": 28}], "pairs": [{"head": "E2", "tail": "E1", "allowed_relation": "treated_by", "id": "R1"}, {"head": "E2", "tail": "E3", "allowed_relation": "located_at", "id": "R2"}]}
{"id": "RV2T-011", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 1721, "selection": "targeted", "text": "chính là vấn đề ngăn ngừa ung thư tái phát bởi vì đôi khi chúng ta cứ sau khi điều trị ung thư rồi lại yên tâm", "entities": [{"id": "E1", "text": "ngăn ngừa", "label": "DRUG", "start": 16, "end": 25, "token_start": 4, "token_end": 6}, {"id": "E2", "text": "ung thư", "label": "CONDITION", "start": 26, "end": 33, "token_start": 6, "token_end": 8}, {"id": "E3", "text": "tái phát", "label": "CONDITION", "start": 34, "end": 42, "token_start": 8, "token_end": 10}, {"id": "E4", "text": "ung thư", "label": "CONDITION", "start": 87, "end": 94, "token_start": 21, "token_end": 23}], "pairs": [{"head": "E2", "tail": "E1", "allowed_relation": "treated_by", "id": "R1"}, {"head": "E3", "tail": "E1", "allowed_relation": "treated_by", "id": "R2"}, {"head": "E4", "tail": "E1", "allowed_relation": "treated_by", "id": "R3"}]}
{"id": "RV2T-012", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 2320, "selection": "targeted", "text": "trường hợp đặc biệt cho nên là những cái thuốc corticoid để điều trị cho bệnh gút phải là những cái trường hợp mà các", "entities": [{"id": "E1", "text": "corticoid", "label": "DRUG", "start": 47, "end": 56, "token_start": 10, "token_end": 11}, {"id": "E2", "text": "bệnh gút", "label": "CONDITION", "start": 73, "end": 81, "token_start": 15, "token_end": 17}], "pairs": [{"head": "E2", "tail": "E1", "allowed_relation": "treated_by", "id": "R1"}]}
{"id": "RV2T-013", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 2440, "selection": "targeted", "text": "nếu mà táo bón mà nó do thuốc gây ra mà bệnh nhân có chỉ định điều trị phẫu", "entities": [{"id": "E1", "text": "táo bón", "label": "CONDITION", "start": 7, "end": 14, "token_start": 2, "token_end": 4}, {"id": "E2", "text": "do thuốc gây ra", "label": "CONDITION", "start": 21, "end": 36, "token_start": 6, "token_end": 10}, {"id": "E3", "text": "chỉ định", "label": "DRUG", "start": 53, "end": 61, "token_start": 14, "token_end": 16}], "pairs": [{"head": "E1", "tail": "E3", "allowed_relation": "treated_by", "id": "R1"}, {"head": "E2", "tail": "E3", "allowed_relation": "treated_by", "id": "R2"}]}
{"id": "RV2T-014", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 2603, "selection": "targeted", "text": "là đau tức ngực thế và khi chúng ta sử dụng lâu dài thì nó sẽ có cái tác dụng phòng ngừa được hỗ trợ trong việc phòng", "entities": [{"id": "E1", "text": "đau tức ngực", "label": "CONDITION", "start": 3, "end": 15, "token_start": 1, "token_end": 4}, {"id": "E2", "text": "phòng ngừa", "label": "DRUG", "start": 78, "end": 88, "token_start": 20, "token_end": 22}, {"id": "E3", "text": "hỗ trợ", "label": "PROCEDURE", "start": 94, "end": 100, "token_start": 23, "token_end": 25}], "pairs": [{"head": "E1", "tail": "E2", "allowed_relation": "treated_by", "id": "R1"}, {"head": "E1", "tail": "E3", "allowed_relation": "treated_by_procedure", "id": "R2"}]}
{"id": "RV2T-015", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 2646, "selection": "targeted", "text": "có nghĩa là bác bác uống cái thuốc đề kháng chống lại covid và xịt họng xịt họng là bác sĩ dùng loại nào ở betadine", "entities": [{"id": "E1", "text": "covid", "label": "CONDITION", "start": 54, "end": 59, "token_start": 12, "token_end": 13}, {"id": "E2", "text": "họng", "label": "BODY_PART", "start": 67, "end": 71, "token_start": 15, "token_end": 16}, {"id": "E3", "text": "họng", "label": "BODY_PART", "start": 76, "end": 80, "token_start": 17, "token_end": 18}, {"id": "E4", "text": "betadine", "label": "DRUG", "start": 107, "end": 115, "token_start": 25, "token_end": 26}], "pairs": [{"head": "E1", "tail": "E2", "allowed_relation": "located_at", "id": "R1"}, {"head": "E1", "tail": "E3", "allowed_relation": "located_at", "id": "R2"}, {"head": "E1", "tail": "E4", "allowed_relation": "treated_by", "id": "R3"}]}
{"id": "RV2T-016", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 2743, "selection": "targeted", "text": "biến chứng của thuốc levodopa nó không không giúp cái việc cải thiện đó được lâu dài được kéo dài suốt ngày thì phẫu", "entities": [{"id": "E1", "text": "biến chứng", "label": "CONDITION", "start": 0, "end": 10, "token_start": 0, "token_end": 2}, {"id": "E2", "text": "levodopa", "label": "DRUG", "start": 21, "end": 29, "token_start": 4, "token_end": 5}, {"id": "E3", "text": "cải thiện", "label": "PROCEDURE", "start": 59, "end": 68, "token_start": 11, "token_end": 13}], "pairs": [{"head": "E1", "tail": "E2", "allowed_relation": "treated_by", "id": "R1"}, {"head": "E1", "tail": "E3", "allowed_relation": "treated_by_procedure", "id": "R2"}]}
{"id": "RV2T-017", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 2870, "selection": "targeted", "text": "người rung nhĩ đều phải uống thuốc kháng đông nhưng mà hầu như là đa số sẽ được sử dụng thuốc kháng đông để phòng", "entities": [{"id": "E1", "text": "rung nhĩ", "label": "CONDITION", "start": 6, "end": 14, "token_start": 1, "token_end": 3}, {"id": "E2", "text": "uống thuốc", "label": "PROCEDURE", "start": 24, "end": 34, "token_start": 5, "token_end": 7}, {"id": "E3", "text": "kháng đông", "label": "PROCEDURE", "start": 35, "end": 45, "token_start": 7, "token_end": 9}, {"id": "E4", "text": "thuốc kháng đông", "label": "DRUG", "start": 88, "end": 104, "token_start": 20, "token_end": 23}], "pairs": [{"head": "E1", "tail": "E2", "allowed_relation": "treated_by_procedure", "id": "R1"}, {"head": "E1", "tail": "E3", "allowed_relation": "treated_by_procedure", "id": "R2"}, {"head": "E1", "tail": "E4", "allowed_relation": "treated_by", "id": "R3"}]}
{"id": "RV2T-018", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 3049, "selection": "targeted", "text": "gắng là phải tuân thủ đầy đủ các cái điều trị đó không nên bỏ dở tôi biết là nhất là những bệnh ung thư trong điều", "entities": [{"id": "E1", "text": "tuân thủ", "label": "DRUG", "start": 13, "end": 21, "token_start": 3, "token_end": 5}, {"id": "E2", "text": "ung thư", "label": "CONDITION", "start": 96, "end": 103, "token_start": 23, "token_end": 25}], "pairs": [{"head": "E2", "tail": "E1", "allowed_relation": "treated_by", "id": "R1"}]}
{"id": "RV2T-019", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 3272, "selection": "targeted", "text": "minh tác dụng kết quả cho thấy kga1 có tác dụng ức chế cơn đau lên đến bảy mươi sáu phần trăm", "entities": [{"id": "E1", "text": "kga1", "label": "DRUG", "start": 31, "end": 35, "token_start": 7, "token_end": 8}, {"id": "E2", "text": "ức chế", "label": "DRUG", "start": 48, "end": 54, "token_start": 11, "token_end": 13}, {"id": "E3", "text": "đau", "label": "CONDITION", "start": 59, "end": 62, "token_start": 14, "token_end": 15}, {"id": "E4", "text": "phần trăm", "label": "DOSAGE", "start": 84, "end": 93, "token_start": 20, "token_end": 22}], "pairs": [{"head": "E1", "tail": "E4", "allowed_relation": "has_dosage", "id": "R1"}, {"head": "E2", "tail": "E4", "allowed_relation": "has_dosage", "id": "R2"}, {"head": "E3", "tail": "E1", "allowed_relation": "treated_by", "id": "R3"}, {"head": "E3", "tail": "E2", "allowed_relation": "treated_by", "id": "R4"}]}
{"id": "RV2T-020", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 3435, "selection": "targeted", "text": "cũng khuyên là bác nên tìm đến viên nang đông trùng hạ thảo cái đó nó dùng nó không chỉ tốt cho vấn đề đái tháo đường", "entities": [{"id": "E1", "text": "viên nang đông trùng hạ thảo", "label": "DRUG", "start": 31, "end": 59, "token_start": 7, "token_end": 13}, {"id": "E2", "text": "đái tháo đường", "label": "CONDITION", "start": 103, "end": 117, "token_start": 24, "token_end": 27}], "pairs": [{"head": "E2", "tail": "E1", "allowed_relation": "treated_by", "id": "R1"}]}
{"id": "RV2T-021", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 3494, "selection": "targeted", "text": "dạng bốn mươi phần trăm tăng huyết áp cũng như là những cái bệnh mạch vành thì ngoài ra thì thấy được kiểm soát mà béo", "entities": [{"id": "E1", "text": "bốn mươi phần trăm", "label": "DOSAGE", "start": 5, "end": 23, "token_start": 1, "token_end": 5}, {"id": "E2", "text": "tăng huyết áp", "label": "CONDITION", "start": 24, "end": 37, "token_start": 5, "token_end": 8}, {"id": "E3", "text": "bệnh mạch vành", "label": "CONDITION", "start": 60, "end": 74, "token_start": 13, "token_end": 16}, {"id": "E4", "text": "kiểm soát", "label": "DRUG", "start": 102, "end": 111, "token_start": 22, "token_end": 24}], "pairs": [{"head": "E2", "tail": "E4", "allowed_relation": "treated_by", "id": "R1"}, {"head": "E3", "tail": "E4", "allowed_relation": "treated_by", "id": "R2"}, {"head": "E4", "tail": "E1", "allowed_relation": "has_dosage", "id": "R3"}]}
{"id": "RV2T-022", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 3816, "selection": "targeted", "text": "quan đến cái xét nghiệm đông máu xem nó như thế nào thì các bác sĩ sẽ điều chỉnh liều lượng bác ạ bác nhé thế và bên cạnh", "entities": [{"id": "E1", "text": "xét nghiệm", "label": "TEST", "start": 13, "end": 23, "token_start": 3, "token_end": 5}, {"id": "E2", "text": "máu", "label": "BODY_PART", "start": 29, "end": 32, "token_start": 6, "token_end": 7}, {"id": "E3", "text": "điều chỉnh", "label": "DRUG", "start": 70, "end": 80, "token_start": 17, "token_end": 19}, {"id": "E4", "text": "liều lượng", "label": "DOSAGE", "start": 81, "end": 91, "token_start": 19, "token_end": 21}], "pairs": [{"head": "E3", "tail": "E4", "allowed_relation": "has_dosage", "id": "R1"}]}
{"id": "RV2T-023", "source": "leduckhai/VietMed-NER", "source_split": "train", "source_row_index": 3993, "selection": "targeted", "text": "rất là nhiều đấy là một trong những cái thuốc chống viêm chống chỉ định để điều trị trong các bệnh gút trừ phi những cái", "entities": [{"id": "E1", "text": "viêm", "label": "CONDITION", "start": 52, "end": 56, "token_start": 11, "token_end": 12}, {"id": "E2", "text": "chỉ định", "label": "DRUG", "start": 63, "end": 71, "token_start": 13, "token_end": 15}, {"id": "E3", "text": "bệnh gút", "label": "CONDITION", "start": 94, "end": 102, "token_start": 20, "token_end": 22}], "pairs": [{"head": "E1", "tail": "E2", "allowed_relation": "treated_by", "id": "R1"}, {"head": "E3", "tail": "E2", "allowed_relation": "treated_by", "id": "R2"}]}
