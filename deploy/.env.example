# Sao chép thành deploy/.env rồi sửa. File .env nằm trong .gitignore, không commit.

# --- PostgreSQL ---
POSTGRES_DB=medkg
POSTGRES_USER=medkg
POSTGRES_PASSWORD=doi-mat-khau-nay

# --- Mô hình ---
# Thư mục chứa vihealthbert-ner-vietmed-v2-final/ và vihealthbert-re-vietmed-811/ (có trọng số .safetensors).
# Đường dẫn tương đối tính từ thư mục deploy/. Trên máy Windows của dự án: ../Code/Model
MODEL_DIR=../Model
NER_MODEL=vihealthbert-ner-vietmed-v2-final
RE_MODEL=vihealthbert-re-vietmed-811
DEVICE=cpu
TORCH_THREADS=4
API_MEMORY=6g
# false: không nạp mô hình, chỉ xem lịch sử và đồ thị đã lưu (máy yếu)
LOAD_MODELS=true

# Nạp sẵn 3.496 câu test VietMed-NER đã phân tích vào CSDL lần đầu (để trống để bỏ qua)
SEED_FILE=/app/seed/results.jsonl

# --- Cổng web công khai ---
WEB_PORT=8080
TAG=latest
