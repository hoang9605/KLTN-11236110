{
  "source": "Code/Model/vihealthbert-ner-vietmed-v2-final/training_args.bin (transformers.TrainingArguments, đọc bằng unpickler không thực thi mã)",
  "base_model": "demdecuong/vihealthbert-base-syllable",
  "dataset": "leduckhai/VietMed-NER (37 nhãn BIO)",
  "learning_rate": 5e-05,
  "num_train_epochs": 30,
  "per_device_train_batch_size": 32,
  "per_device_eval_batch_size": 32,
  "gradient_accumulation_steps": 1,
  "weight_decay": 0.01,
  "warmup_steps": 0,
  "lr_scheduler_type": "linear",
  "optim": "adamw_torch_fused",
  "adam_beta1": 0.9, "adam_beta2": 0.999, "adam_epsilon": 1e-08,
  "max_grad_norm": 1.0,
  "fp16": true,
  "seed": 42,
  "eval_strategy": "epoch",
  "save_strategy": "epoch",
  "load_best_model_at_end": true,
  "metric_for_best_model": "f1",
  "output_dir": "./vihealthbert-ner-vietmed-v2",
  "not_recorded_here": ["F1 validation tốt nhất", "epoch được chọn", "phần cứng huấn luyện", "max_length lúc huấn luyện"]
}
